# Bot identity
BOT_NAME=BRITECH-NB
OWNER_NAME=BRIAN NDICHI
OWNER_NUMBER=254717276195
OWNER_EMAIL=brianndichi340@gmail.com
PREFIX=.
TIMEZONE=Africa/Nairobi
BOT_MODE=private
RUNTIME_SETTINGS_FILE=./runtime-settings.json

# Optional AI integration (keep the real key private)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Free-tier alternative for .ai; create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Optional Manus API integration for owner-only .manus tasks.
# Set the real key only in private KataBump host variables or an uncommitted root .env.
MANUS_API_KEY=

# Runtime settings
# Paste your complete BRITECH3: value from the generated Word document or WhatsApp message.
# Keep your real SESSION_ID private. Leave this blank until you have generated one.
SESSION_ID=
SESSION_DIR=./session/auth
AUTO_READ=false
AUTO_TYPING=false
AUTO_VIEW_STATUS=true
AUTO_LIKE_STATUS=true
AUTO_REACT_COMMANDS=true
AUTO_ANTI_DELETE=true
AUTO_SET_BOT_PROFILE=true
# On repeated Bad MAC decryption errors, preserve the active auth folder,
# rotate to one validated auth backup, and let the host restart the process once.
AUTO_SESSION_RECOVERY=true
BAD_MAC_RECOVERY_THRESHOLD=3
STATUS_LIKE_EMOJI=💕
STATUS_LIKE_EMOJIS=💕,💞,💖,💯,🥰
COMMAND_REACTION_EMOJIS=💕,💞,💖,💯,🥰
LOG_LEVEL=info
# Group-join welcome and one-time DM to the linked account after WhatsApp connects; {user} is a group mention placeholder.
WELCOME_MESSAGE="WELCOME TO BRITECH BOT🔥💯\nFOUNDED BY BRIAN N.🌺"

# Web pairing dashboard. Leave empty for explicit public mode: anyone who can reach
# the dashboard can pair a WhatsApp account, receive a session, and deploy BRITECH-MD.
# For private deployments, set a long random token on the host only. Never commit it.
PAIRING_DASHBOARD_TOKEN=
# Optional HTTPS/HTTP dashboard URL. Pair Code and Generate Session ID only navigate
# to this site with a panel hash; they never start a Manus workflow or include secrets.
PAIRING_DASHBOARD_URL=
PAIRING_PORT=3000
# Maximum time allowed for one phone-number pairing attempt (milliseconds).
PAIRING_TIMEOUT_MS=300000
