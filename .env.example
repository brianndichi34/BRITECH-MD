# Runtime settings
# Paste your complete BRITECH3: value from the generated Word document or WhatsApp message.
# Keep your real SESSION_ID private. Leave this blank until you have generated one.
SESSION_ID=
SESSION_DIR=./session/auth
AUTO_READ=false
AUTO_TYPING=false
AUTO_VIEW_STATUS=true
AUTO_LIKE_STATUS=true
AUTO_REACT_COMMANDS=true
AUTO_ANTI_DELETE=true
AUTO_SET_BOT_PROFILE=true
# On repeated Bad MAC decryption errors, preserve the active auth folder,
# rotate to one validated auth backup, and let the host restart the process once.
AUTO_SESSION_RECOVERY=true
BAD_MAC_RECOVERY_THRESHOLD=3
STATUS_LIKE_EMOJI=💕
STATUS_LIKE_EMOJIS=💕,💞,💖,💯,🥰
COMMAND_REACTION_EMOJIS=💕,💞,💖,💯,🥰
LOG_LEVEL=info
# Group-join welcome and one-time DM to the linked account after WhatsApp connects; {user} is a group mention placeholder.
WELCOME_MESSAGE="WELCOME TO BRITECH BOT🔥💯\nFOUNDED BY BRIAN N.🌺"

# Optional web pairing dashboard; set a private random token on your host only.
PAIRING_DASHBOARD_TOKEN=
PAIRING_PORT=3000
