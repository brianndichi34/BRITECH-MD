{
  "name": "britech-md",
  "version": "1.2.0",
  "description": "BRITECH MD WhatsApp multi-device assistant",
  "main": "index.js",
  "type": "commonjs",
  "scripts": {
    "start": "node index.js",
    "pair:server": "node pairing-server.js",
    "session": "node generate-session.js",
    "session:ci": "node generate-session.js --ci",
    "session:send": "node send-session.js",
    "check": "node --check index.js && node --check pairing-server.js && node --check generate-session.js && node --check send-session.js && node --check lib/handler.js && node --check lib/config.js && node --check lib/pairing-session.js && node --check lib/session-id.js",
    "test": "npm run check && node --test tests/*.test.js"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@whiskeysockets/baileys": "6.7.24",
    "dotenv": "^16.4.7",
    "jszip": "^3.10.2",
    "mathjs": "^14.2.1",
    "pino": "^9.6.0"
  }
}
